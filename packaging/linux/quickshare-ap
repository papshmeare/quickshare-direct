#!/usr/bin/env bash
# quickshare-ap: temporary direct Wi-Fi link for Quick Share transfers (runs as root, started on
# demand by the receiver via `systemctl start quickshare-ap`; see quickshare-ap.service).
#
# Two ways, next to the normal Wi-Fi connection (which keeps working), on its channel:
#   p2p (default): a Wi-Fi Direct group (we are group owner) via wpa_supplicant's D-Bus API. Phones
#        join Wi-Fi Direct on a separate virtual interface, so it doesn't fight with the phone
#        reconnecting to its usual Wi-Fi (a plain hotspot does: the phone has to leave its network).
#   ap:  a hotspot on a virtual AP interface with hostapd (fallback if p2p fails).
# dnsmasq gives the phone an address. Writes mode/ssid/password/frequency/gateway to
# $RUNTIME_DIRECTORY/credentials (group-readable) for the receiver, which sends them to the phone
# over the encrypted Bluetooth channel. Everything is removed when the service stops.
#
# Environment: QS_MODE (p2p or ap, default p2p),
#              QS_STA (station interface, default: first managed Wi-Fi interface),
#              QS_AP (AP interface name, default ap0), QS_USER (user who may read the credentials;
#              the template unit quickshare-ap@USER sets it), else QS_GROUP (group allowed to read
#              them, default users), QS_SUBNET (default 10.42.0).
# Needs: iw, iproute2, dnsmasq, busctl (systemd), wpa_supplicant with P2P + D-Bus (p2p), hostapd (ap).
# NetworkManager must leave $QS_AP and p2p-<sta>-* unmanaged.
set -euo pipefail

AP=${QS_AP:-ap0}
GROUP=${QS_GROUP:-users}
[ -n "${QS_USER:-}" ] && GROUP=$(id -gn "$QS_USER")
NET=${QS_SUBNET:-10.42.0}
DIR=${RUNTIME_DIRECTORY:-/run/quickshare}
mkdir -p "$DIR"
STA=${QS_STA:-$(iw dev | awk '/Interface/{i=$2} /type managed/{print i; exit}')}

WPAS=fi.w1.wpa_supplicant1
# wpa_supplicant D-Bus object of an interface name (e.g. p2p-dev-wlp4s0), or nothing.
wpas_obj() {
  local p
  for p in $(busctl get-property $WPAS /fi/w1/wpa_supplicant1 $WPAS Interfaces | grep -o '"/[^"]*"' | tr -d '"'); do
    [ "$(busctl get-property $WPAS "$p" $WPAS.Interface Ifname 2>/dev/null)" = "s \"$1\"" ] && { echo "$p"; return 0; }
  done
  return 1
}

# Let the phone reach us on the link interface (its name varies, e.g. p2p-wlp4s0-3): firewalld
# (trusted zone), ufw (allow in on it), else an nftables rule in QS_NFT_CHAIN="family table chain"
# (default: NixOS "inet nixos-fw input-allow"; skipped if that chain doesn't exist).
NFT_CHAIN=${QS_NFT_CHAIN:-inet nixos-fw input-allow}
fw_allow() {
  if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --zone=trusted --add-interface="$1" >/dev/null && FW_FIREWALLD=$1
  elif command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw allow in on "$1" comment quickshare >/dev/null && FW_UFW=$1
  elif command -v nft >/dev/null; then
    # shellcheck disable=SC2086
    NFT_HANDLE=$(nft --echo --handle insert rule $NFT_CHAIN iifname "$1" accept comment quickshare 2>/dev/null |
      sed -n 's/.*# handle \([0-9]*\).*/\1/p') || true
  fi
}
fw_cleanup() {
  [ -n "${FW_FIREWALLD:-}" ] && firewall-cmd --zone=trusted --remove-interface="$FW_FIREWALLD" >/dev/null 2>&1
  [ -n "${FW_UFW:-}" ] && ufw delete allow in on "$FW_UFW" >/dev/null 2>&1
  # shellcheck disable=SC2086
  [ -n "${NFT_HANDLE:-}" ] && nft delete rule $NFT_CHAIN handle "$NFT_HANDLE" 2>/dev/null
  return 0
}

cleanup() {
  fw_cleanup
  [ -n "${DNSMASQ:-}" ] && kill "$DNSMASQ" 2>/dev/null || true
  [ -n "${GOBJ:-}" ] && busctl call $WPAS "$GOBJ" $WPAS.Interface.P2PDevice Disconnect 2>/dev/null || true
  [ -f "$DIR/hostapd.pid" ] && kill "$(cat "$DIR/hostapd.pid")" 2>/dev/null || true
  iw dev "$AP" del 2>/dev/null || true
  rm -f "$DIR/credentials" "$DIR/hostapd.conf" "$DIR/hostapd.pid" "$DIR/leases"
}
trap cleanup EXIT
trap 'exit 0' TERM INT

# Channel of the station connection ("channel 44 (5220 MHz), width: 160 MHz, ...").
read -r CHAN FREQ < <(iw dev "$STA" info 2>/dev/null |
  sed -n 's/.*channel \([0-9]*\) (\([0-9]*\) MHz.*/\1 \2/p') || true
if [ -z "${CHAN:-}" ]; then CHAN=36; FREQ=5180; fi   # not connected: any non-DFS 5 GHz channel

# Whether we may start a network on a frequency: listed for our phy, and not marked "radar
# detection" (DFS), "no IR" or "disabled" (iw phy: "* 5500.0 MHz [100] (26.0 dBm) (radar detection)").
PHY=$(cat "/sys/class/net/$STA/phy80211/name" 2>/dev/null || true)
PHYINFO=$(iw phy ${PHY:+"$PHY"} info 2>/dev/null || iw phy 2>/dev/null || true)
usable() {
  local l
  l=$(printf '%s\n' "$PHYINFO" | grep -E "^[[:space:]]+\* $1(\.0)? MHz" | head -1)
  [ -n "$l" ] && ! printf '%s\n' "$l" | grep -qE "radar detection|no IR|disabled"
}
# The Wi-Fi Direct group goes on the station's channel when it can; a station on a DFS channel
# (e.g. 100) can't host one, so the group takes the first usable channel instead (the chip runs it
# on a second channel next to the station). A plain hotspot must share the station's channel.
GO_FREQ=$FREQ
if ! usable "$FREQ"; then
  GO_FREQ=
  for f in 5180 5200 5220 5240 5745 5765 5785 5805 2437 2412 2462; do
    if usable "$f"; then GO_FREQ=$f; break; fi
  done
  echo "quickshare-ap: station channel $CHAN ($FREQ MHz) needs radar detection or is no-IR; Wi-Fi Direct group on ${GO_FREQ:-a channel wpa_supplicant picks} MHz"
fi

# Read a finite amount of randomness (tr < /dev/urandom | head would end in SIGPIPE + pipefail).
rnd() { head -c 512 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c "1-$1"; }

# Wi-Fi Direct group owner via wpa_supplicant; sets IF, SSID, PASS, GOBJ. Returns 1 if unavailable.
start_p2p() {
  local dev grp ssid_bytes i
  # The P2P device functions live on the station interface's object (P2PDevice interface).
  dev=$(wpas_obj "$STA") || { echo "quickshare-ap: $STA not in wpa_supplicant" >&2; return 1; }
  # Widest first: without ht40/vht/he the group runs 802.11n at 20 MHz (~144 Mbit/s, ~12 MB/s).
  local f=() n=0
  [ -n "$GO_FREQ" ] && { f=(frequency i "$GO_FREQ"); n=1; }
  busctl call $WPAS "$dev" $WPAS.Interface.P2PDevice GroupAdd 'a{sv}' $((n + 4)) \
      persistent b false "${f[@]}" ht40 b true vht b true he b true >/dev/null ||
    busctl call $WPAS "$dev" $WPAS.Interface.P2PDevice GroupAdd 'a{sv}' $((n + 3)) \
      persistent b false "${f[@]}" ht40 b true vht b true >/dev/null ||
    busctl call $WPAS "$dev" $WPAS.Interface.P2PDevice GroupAdd 'a{sv}' $((n + 1)) \
      persistent b false "${f[@]}" >/dev/null || return 1
  for i in $(seq 50); do
    IF=$(ls /sys/class/net | grep "^p2p-$STA-" | head -1 || true)
    [ -n "$IF" ] && GOBJ=$(wpas_obj "$IF") && break
    sleep 0.1
  done
  [ -n "${GOBJ:-}" ] || { echo "quickshare-ap: P2P group interface didn't appear" >&2; return 1; }
  for i in $(seq 50); do
    grp=$(busctl get-property $WPAS "$GOBJ" $WPAS.Interface.P2PDevice Group 2>/dev/null | grep -o '"/[^"]*"' | tr -d '"' || true)
    [ -n "$grp" ] && [ "$grp" != "/" ] && break
    sleep 0.1
  done
  # SSID property is "ay N b1 b2 ...": bytes → string
  ssid_bytes=$(busctl get-property $WPAS "$grp" $WPAS.Group SSID | cut -d' ' -f3-)
  SSID=$(for b in $ssid_bytes; do printf "\\x$(printf %02x "$b")"; done)
  PASS=$(busctl get-property $WPAS "$grp" $WPAS.Group Passphrase | sed 's/^s "\(.*\)"$/\1/')
  # The channel the group really uses (what the phone is told), e.g. "q 5180".
  GROUP_FREQ=$(busctl get-property $WPAS "$grp" $WPAS.Group Frequency 2>/dev/null | awk '{print $2}' || true)
  [ -n "$SSID" ] && [ -n "$PASS" ]
}

start_ap() {
if ! usable "$FREQ"; then
  echo "quickshare-ap: no hotspot either: it would have to share the station's channel $CHAN ($FREQ MHz), which needs radar detection" >&2
  return 1
fi
IF=$AP
iw dev "$AP" del 2>/dev/null || true
iw dev "$STA" interface add "$AP" type __ap
SSID="QuickShare-$(rnd 6)"
PASS="$(rnd 16)"

{
  echo "interface=$AP"
  echo "driver=nl80211"
  echo "ssid=$SSID"
  echo "channel=$CHAN"
  echo "wmm_enabled=1"
  echo "ieee80211n=1"
  echo "wpa=2"
  echo "wpa_key_mgmt=WPA-PSK"
  echo "rsn_pairwise=CCMP"
  echo "wpa_passphrase=$PASS"
  if [ "$FREQ" -ge 5000 ]; then
    echo "hw_mode=a"
    echo "ieee80211ac=1"
    # 40/80 MHz around the primary channel (UNII bands; DFS channels aren't used by an AP here).
    case $CHAN in
      36|44|52|60|100|108|116|124|132|140|149|157) echo "ht_capab=[HT40+][SHORT-GI-20][SHORT-GI-40]" ;;
      *) echo "ht_capab=[HT40-][SHORT-GI-20][SHORT-GI-40]" ;;
    esac
    case $CHAN in
      36|40|44|48) C=42 ;; 52|56|60|64) C=58 ;; 100|104|108|112) C=106 ;;
      116|120|124|128) C=122 ;; 132|136|140|144) C=138 ;; 149|153|157|161) C=155 ;; *) C= ;;
    esac
    if [ -n "$C" ]; then echo "vht_oper_chwidth=1"; echo "vht_oper_centr_freq_seg0_idx=$C"; fi
  else
    echo "hw_mode=g"
  fi
} > "$DIR/hostapd.conf"

if ! hostapd -B -P "$DIR/hostapd.pid" "$DIR/hostapd.conf" >/dev/null; then
  # Fall back to a plain 20 MHz AP (some drivers refuse the wider channel next to the station).
  sed -i '/^ht_capab=/d; /^vht_/d; /^ieee80211ac=/d' "$DIR/hostapd.conf"
  hostapd -B -P "$DIR/hostapd.pid" "$DIR/hostapd.conf" >/dev/null
fi
}

MODE=${QS_MODE:-p2p}
if [ "$MODE" = p2p ] && ! start_p2p; then
  echo "quickshare-ap: Wi-Fi Direct failed, using a hotspot instead" >&2
  [ -n "${GOBJ:-}" ] && busctl call $WPAS "$GOBJ" $WPAS.Interface.P2PDevice Disconnect 2>/dev/null || true
  GOBJ=; MODE=ap
fi
if [ "$MODE" = ap ]; then start_ap || exit 1; LINK_FREQ=$FREQ; else LINK_FREQ=${GROUP_FREQ:-${GO_FREQ:-$FREQ}}; fi

ip addr add "$NET.1/24" dev "$IF"
ip link set "$IF" up
fw_allow "$IF"
dnsmasq --keep-in-foreground --conf-file=/dev/null --port=0 \
  --interface="$IF" --bind-interfaces --except-interface=lo \
  --dhcp-range="$NET.10,$NET.254,255.255.255.0,1h" \
  --dhcp-leasefile="$DIR/leases" &
DNSMASQ=$!

umask 027
printf 'mode=%s\nssid=%s\npassword=%s\nfrequency=%s\ngateway=%s\n' "$MODE" "$SSID" "$PASS" "$LINK_FREQ" "$NET.1" \
  > "$DIR/credentials.tmp"
chgrp "$GROUP" "$DIR/credentials.tmp" "$DIR"
chmod 0750 "$DIR"
mv "$DIR/credentials.tmp" "$DIR/credentials"
echo "quickshare-ap: $MODE $SSID on $IF ($LINK_FREQ MHz), next to $STA (channel $CHAN, $FREQ MHz)"

wait "$DNSMASQ"

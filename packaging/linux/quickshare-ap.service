# Temporary Wi-Fi hotspot for Quick Share transfers. Started/stopped on demand by the receiver.
# Allow your user to start it without a password, e.g. polkit (replace "me"):
#   polkit.addRule(function (action, subject) {
#     if (action.id == "org.freedesktop.systemd1.manage-units" &&
#         action.lookup("unit") == "quickshare-ap.service" && subject.user == "me")
#       return polkit.Result.YES;
#   });
# NetworkManager must not manage the AP interface: in NetworkManager.conf
#   [keyfile]
#   unmanaged-devices=interface-name:ap0
[Unit]
Description=Temporary Wi-Fi hotspot for Quick Share transfers

[Service]
Type=simple
ExecStart=/usr/local/bin/quickshare-ap
ExecStopPost=-/usr/bin/iw dev ap0 del
RuntimeDirectory=quickshare
RuntimeDirectoryMode=0750

# Direct Wi-Fi link (Wi-Fi Direct group or hotspot) for receiving; started on demand by the
# receiver of user %i (quickshare-ap@USER), who may read its credentials.
[Unit]
Description=Quick Share direct Wi-Fi link for %i

[Service]
Type=simple
Environment=QS_USER=%i
EnvironmentFile=-/etc/default/quickshare-direct
ExecStart=@LIBEXECDIR@/quickshare-ap
ExecStopPost=-/bin/sh -c 'iw dev ap0 del 2>/dev/null'
RuntimeDirectory=quickshare
RuntimeDirectoryMode=0750

# Bluetooth settings for Quick Share (packaging/linux/quickshare-bt-setup): adapter connectable,
# shorter LE connection interval (QS_LE_CONN_INTERVAL in /etc/default/quickshare-direct).
[Unit]
Description=Keep the Bluetooth adapter connectable (Quick Share)
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 2
EnvironmentFile=-/etc/default/quickshare-direct
ExecStart=@LIBEXECDIR@/quickshare-bt-setup

[Install]
WantedBy=bluetooth.target

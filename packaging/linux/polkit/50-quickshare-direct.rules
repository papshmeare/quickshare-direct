// quickshare-direct: let a user with an active local session start and stop their own instance
// of the Wi-Fi helpers (quickshare-ap@USER for receiving, quickshare-join@USER for sending).
polkit.addRule(function (action, subject) {
  if (action.id != "org.freedesktop.systemd1.manage-units" || !subject.active || !subject.local) {
    return polkit.Result.NOT_HANDLED;
  }
  var unit = action.lookup("unit");
  var verb = action.lookup("verb");
  if ((unit == "quickshare-ap@" + subject.user + ".service" ||
       unit == "quickshare-join@" + subject.user + ".service") &&
      (verb == "start" || verb == "stop" || verb == "restart")) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});

#!/usr/bin/env bash
# quickshare-join: join a phone's Wi-Fi Direct group / hotspot for sending (runs as root, started on
# demand by the sender via `systemctl start quickshare-join`; see quickshare-join.service).
#
# When we send, the phone is the one that hosts the fast link and gives us its credentials over the
# encrypted Bluetooth channel. We join it on a second station interface ($QS_CLI, default qsc0) so
# the normal Wi-Fi connection keeps working (needs a chip that allows two managed interfaces on two
# channels: `iw list` "#{ managed, P2P-client } <= 2 ... #channels <= 2").
#
# Request: $QS_REQUEST (default /run/user/<uid of $QS_USER>/quickshare-join), written by the sender,
# owned by $QS_USER, with ssid=, password=, frequency= and gateway= lines. Result:
# $RUNTIME_DIRECTORY/joined (group-readable) with iface= and ip= once we have an address.
# Everything is removed when the service stops.
#
# Environment: QS_USER (required; the template unit quickshare-join@USER sets it),
#              QS_SINGLE_CHANNEL (auto/always/never, see below),
#              QS_STA (station interface, default: first managed interface), QS_CLI (default qsc0),
#              QS_REQUEST.
# Needs: iw, iproute2, busctl (systemd), wpa_supplicant with D-Bus; busybox (udhcpc) optional
# (without it: a fixed address in the gateway's /24).
# NetworkManager must leave $QS_CLI unmanaged.
set -euo pipefail

CLI=${QS_CLI:-qsc0}
DIR=${RUNTIME_DIRECTORY:-/run/quickshare-join}
mkdir -p "$DIR"
STA=${QS_STA:-$(iw dev | awk '/Interface/{i=$2} /type managed/{print i; exit}')}
: "${QS_USER:?QS_USER must name the user allowed to request a join}"
REQ=${QS_REQUEST:-/run/user/$(id -u "$QS_USER")/quickshare-join}
GROUP=$(id -gn "$QS_USER")

# The request comes from an unprivileged user: a regular file of theirs, no symlink.
[ -f "$REQ" ] && [ ! -L "$REQ" ] && [ "$(stat -c %U "$REQ")" = "$QS_USER" ] ||
  { echo "quickshare-join: no valid request at $REQ" >&2; exit 1; }
get() { sed -n "s/^$1=//p" "$REQ" | head -1; }
SSID=$(get ssid); PASS=$(get password); FREQ=$(get frequency); GW=$(get gateway)
[ -n "$SSID" ] && [ -n "$PASS" ] || { echo "quickshare-join: request without ssid/password" >&2; exit 1; }
case $FREQ in ''|*[!0-9]*) FREQ= ;; esac
case $GW in *[!0-9.]*) GW= ;; esac

WPAS=fi.w1.wpa_supplicant1
cleanup() {
  set +e  # finish every step, above all the station reconnect
  [ -n "${DHCP:-}" ] && kill "$DHCP" 2>/dev/null || true
  [ -n "${IOBJ:-}" ] && busctl call $WPAS /fi/w1/wpa_supplicant1 $WPAS RemoveInterface o "$IOBJ" 2>/dev/null || true
  iw dev "$CLI" del 2>/dev/null || true
  rm -f "$DIR/joined" "$DIR/udhcpc.sh"
  sta_reconnect
}
# Single-channel fallback (QS_SINGLE_CHANNEL): the phone's group usually runs on another channel
# than our station network. Joining it on a second channel works on most chips but halves the
# speed or worse (MT7922: 2.5 instead of ~36 MB/s), and fails on some. auto (default): try next
# to the station first, and if that fails leave the station network for the transfer and retry;
# always: leave it up front whenever the channels differ (full speed); never: don't touch it.
SINGLE=${QS_SINGLE_CHANNEL:-auto}
STA_DISCONNECTED=
sta_disconnect() {
  command -v nmcli >/dev/null || { echo "quickshare-join: no nmcli, can't free the radio" >&2; return 1; }
  echo "quickshare-join: leaving the station network on $STA for the transfer (QS_SINGLE_CHANNEL=$SINGLE)"
  # Remember exactly which connection was up, to bring back that one (not just any network).
  STA_CONN=$(nmcli -g UUID,DEVICE connection show --active 2>/dev/null |
    awk -F: -v d="$STA" '$2 == d { print $1; exit }')
  nmcli -w 10 device disconnect "$STA" >/dev/null || return 1
  STA_DISCONNECTED=1
  # If we die before reconnecting, the unit's ExecStopPost reconnects from this marker.
  echo "$STA_CONN" > "/run/quickshare-reconnect-$STA"
  # A disconnected station gets scanned for networks right away (all channels, ~8 s on 5 GHz with
  # its passive DFS channels) and periodically after that, which takes the radio off the link's
  # channel: the phone's join attempt then times out. Abort station scans while we hold the radio.
  { stdbuf -oL iw event 2>/dev/null | while read -r line; do
      case $line in "$STA (phy"*"scan started"*) iw dev "$STA" scan abort 2>/dev/null ;; esac
    done; } 2>/dev/null &
  SCAN_GUARD=$!
  disown "$SCAN_GUARD" 2>/dev/null || true  # no "Terminated" job report when we stop it
  sleep 0.3; iw dev "$STA" scan abort 2>/dev/null || true
}
sta_reconnect() {
  if [ -n "$STA_DISCONNECTED" ]; then
    if [ -n "${SCAN_GUARD:-}" ]; then
      pkill -P "$SCAN_GUARD" 2>/dev/null; kill "$SCAN_GUARD" 2>/dev/null
      sleep 0.2  # let the last scan abort land before NetworkManager rescans to reconnect
    fi
    echo "quickshare-join: reconnecting $STA${STA_CONN:+ (connection $STA_CONN)}"
    if [ -z "$STA_CONN" ] || ! nmcli -w 0 connection up uuid "$STA_CONN" ifname "$STA" >/dev/null 2>&1; then
      nmcli -w 0 device connect "$STA" >/dev/null 2>&1 || true
    fi
    rm -f "/run/quickshare-reconnect-$STA"
  fi
}
trap cleanup EXIT
trap 'exit 0' TERM INT

STA_FREQ=$(iw dev "$STA" info 2>/dev/null | sed -n 's/.*channel [0-9]* (\([0-9]*\) MHz.*/\1/p' || true)
OTHER_CHANNEL=
[ -n "$STA_FREQ" ] && [ -n "$FREQ" ] && [ "$STA_FREQ" != "$FREQ" ] && OTHER_CHANNEL=1
[ "$SINGLE" = always ] && [ -n "$OTHER_CHANNEL" ] && { sta_disconnect || true; }

iw dev "$CLI" del 2>/dev/null || true
iw dev "$STA" interface add "$CLI" type managed
ip link set "$CLI" up

IOBJ=$(busctl call $WPAS /fi/w1/wpa_supplicant1 $WPAS CreateInterface 'a{sv}' 2 \
  Ifname s "$CLI" Driver s nl80211 | sed 's/^o "\(.*\)"$/\1/')
if [ -n "$FREQ" ]; then
  NOBJ=$(busctl call $WPAS "$IOBJ" $WPAS.Interface AddNetwork 'a{sv}' 4 \
    ssid s "$SSID" psk s "$PASS" scan_freq s "$FREQ" freq_list s "$FREQ" | sed 's/^o "\(.*\)"$/\1/')
else
  NOBJ=$(busctl call $WPAS "$IOBJ" $WPAS.Interface AddNetwork 'a{sv}' 2 \
    ssid s "$SSID" psk s "$PASS" | sed 's/^o "\(.*\)"$/\1/')
fi
busctl call $WPAS "$IOBJ" $WPAS.Interface SelectNetwork o "$NOBJ"

joined() { [ "$(busctl get-property $WPAS "$IOBJ" $WPAS.Interface State)" = 's "completed"' ]; }
wait_joined() { # tenths of a second
  local n
  for ((n = 0; n < $1; n++)); do joined && return 0; sleep 0.1; done
  joined
}
if ! wait_joined "$( [ "$SINGLE" = auto ] && [ -n "$OTHER_CHANNEL" ] && [ -z "$STA_DISCONNECTED" ] && echo 60 || echo 150)"; then
  if [ "$SINGLE" = auto ] && [ -n "$OTHER_CHANNEL" ] && [ -z "$STA_DISCONNECTED" ] && sta_disconnect; then
    busctl call $WPAS "$IOBJ" $WPAS.Interface SelectNetwork o "$NOBJ"
    wait_joined 100 || { echo "quickshare-join: couldn't join $SSID" >&2; exit 1; }
  else
    echo "quickshare-join: couldn't join $SSID" >&2; exit 1
  fi
fi

# Address from the phone's DHCP server; a fixed one in the gateway's /24 if that doesn't answer.
cat > "$DIR/udhcpc.sh" <<'EOF'
#!/bin/sh
case "$1" in bound|renew) ip addr flush dev "$interface"; ip addr add "$ip/${mask:-24}" dev "$interface" ;; esac
EOF
chmod 0700 "$DIR/udhcpc.sh"
if command -v busybox >/dev/null && busybox udhcpc -i "$CLI" -n -q -t 4 -T 1 -s "$DIR/udhcpc.sh" >/dev/null 2>&1; then
  :
elif [ -n "$GW" ]; then
  ip addr add "${GW%.*}.$((100 + RANDOM % 100))/24" dev "$CLI"
else
  echo "quickshare-join: no address on $CLI" >&2; exit 1
fi
IP=$(ip -4 -o addr show dev "$CLI" | awk '{print $4}' | cut -d/ -f1 | head -1)

umask 027
printf 'iface=%s\nip=%s\n' "$CLI" "$IP" > "$DIR/joined.tmp"
chgrp "$GROUP" "$DIR/joined.tmp" "$DIR"
chmod 0750 "$DIR"
mv "$DIR/joined.tmp" "$DIR/joined"
echo "quickshare-join: joined $SSID on $CLI ($FREQ MHz) as $IP, next to $STA (${STA_FREQ:-no} MHz${STA_DISCONNECTED:+, disconnected for the transfer})"

# Stay up until the sender stops the service.
while :; do sleep 3600 & wait $!; done
